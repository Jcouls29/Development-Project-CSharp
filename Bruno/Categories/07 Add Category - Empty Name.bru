meta {
  name: Add Category - Empty Name
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/categories
  body: json
  auth: none
}

body:json {
  {
    "name": "",
    "description": "Valid description"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("returns 400 when name is empty", function() {
    expect(res.status).to.equal(400);
  });
  test("returns problem details title", function() {
    expect(res.body.title).to.equal("Invalid request");
  });
}
