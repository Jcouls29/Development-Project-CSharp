meta {
  name: Add Category
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/categories
  body: json
  auth: none
}

body:json {
  {
    "name": "Electronics",
    "description": "Electronic devices and components",
    "parentCategoryIds": []
  }
}

assert {
  res.status: eq 201
  res.body.instanceId: isDefined
}

vars:post-response {
  categoryId: res.body.instanceId
}

tests {
  test("returns 201 Created", function() {
    expect(res.status).to.equal(201);
  });
  test("returns a numeric instanceId", function() {
    expect(res.body.instanceId).to.be.a("number");
    expect(res.body.instanceId).to.be.greaterThan(0);
  });
}
