meta {
  name: Add Inventory - TypeCategory Too Long
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/v1/inventory/add
  body: json
  auth: none
}

body:json {
  {
    "productInstanceId": {{productId}},
    "quantity": 10,
    "typeCategory": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("returns 400 when typeCategory exceeds 32 characters", function() {
    expect(res.status).to.equal(400);
  });
  test("returns problem details title", function() {
    expect(res.body.title).to.equal("Invalid request");
  });
}
