meta {
  name: Get Count by Metadata
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/inventory/count/metadata
  body: json
  auth: none
}

body:json {
  {
    "attributes": {
      "Color": "Red",
      "Brand": "Acme"
    }
  }
}

assert {
  res.status: eq 200
  res.body.count: isDefined
}

tests {
  test("returns 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  test("count is a number", function() {
    expect(res.body.count).to.be.a("number");
  });
  test("count is greater than zero", function() {
    expect(res.body.count).to.be.greaterThan(0);
  });
  test("response includes the queried attributes", function() {
    expect(res.body.attributes).to.deep.include({ Color: "Red", Brand: "Acme" });
  });
}
