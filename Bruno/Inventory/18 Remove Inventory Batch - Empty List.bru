meta {
  name: Remove Inventory Batch - Empty List
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/api/v1/inventory/remove/batch
  body: json
  auth: none
}

body:json {
  []
}

assert {
  res.status: eq 400
}

tests {
  test("returns 400 when batch list is empty", function() {
    expect(res.status).to.equal(400);
  });
  test("returns problem details title", function() {
    expect(res.body.title).to.equal("Invalid request");
  });
}
