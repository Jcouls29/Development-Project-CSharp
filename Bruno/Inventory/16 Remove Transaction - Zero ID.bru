meta {
  name: Remove Transaction - Zero ID
  type: http
  seq: 16
}

delete {
  url: {{baseUrl}}/api/v1/inventory/transaction/0
  body: none
  auth: none
}

assert {
  res.status: eq 400
}

tests {
  test("returns 400 when transaction ID is zero", function() {
    expect(res.status).to.equal(400);
  });
  test("returns problem details title", function() {
    expect(res.body.title).to.equal("Invalid request");
  });
}
