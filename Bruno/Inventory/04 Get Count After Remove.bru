meta {
  name: Get Count After Remove
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/inventory/count/{{productId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  test("count is 7 after removing 3 from 10", function() {
    expect(res.body.count).to.equal(7);
  });
}
