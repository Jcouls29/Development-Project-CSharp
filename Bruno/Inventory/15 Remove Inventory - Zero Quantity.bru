meta {
  name: Remove Inventory - Zero Quantity
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/api/v1/inventory/remove
  body: json
  auth: none
}

body:json {
  {
    "productInstanceId": {{productId}},
    "quantity": 0
  }
}

assert {
  res.status: eq 400
}

tests {
  test("returns 400 when quantity is zero", function() {
    expect(res.status).to.equal(400);
  });
  test("returns problem details title", function() {
    expect(res.body.title).to.equal("Invalid request");
  });
}
