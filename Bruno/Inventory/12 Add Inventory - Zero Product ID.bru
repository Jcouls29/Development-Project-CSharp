meta {
  name: Add Inventory - Zero Product ID
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/inventory/add
  body: json
  auth: none
}

body:json {
  {
    "productInstanceId": 0,
    "quantity": 10
  }
}

assert {
  res.status: eq 400
}

tests {
  test("returns 400 when productInstanceId is zero", function() {
    expect(res.status).to.equal(400);
  });
  test("returns problem details title", function() {
    expect(res.body.title).to.equal("Invalid request");
  });
}
