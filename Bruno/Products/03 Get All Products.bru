meta {
  name: Get All Products
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/products
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("returns 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  test("returns an array", function() {
    expect(res.body).to.be.an("array");
  });
  test("Widget A is in the list", function() {
    const found = res.body.some(p => p.name === "Widget A");
    expect(found).to.be.true;
  });
}
