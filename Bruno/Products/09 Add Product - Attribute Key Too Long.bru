meta {
  name: Add Product - Attribute Key Too Long
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/products
  body: json
  auth: none
}

body:json {
  {
    "name": "Validation Test Product",
    "description": "Valid description",
    "attributes": {
      "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA": "Red"
    }
  }
}

assert {
  res.status: eq 400
}

tests {
  test("returns 400 when attribute key exceeds 64 characters", function() {
    expect(res.status).to.equal(400);
  });
  test("returns problem details title", function() {
    expect(res.body.title).to.equal("Invalid request");
  });
}
