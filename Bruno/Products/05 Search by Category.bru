meta {
  name: Search by Category
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/products/search
  body: json
  auth: none
}

body:json {
  {
    "categoryIds": [{{categoryId}}]
  }
}

assert {
  res.status: eq 200
}

tests {
  test("returns 200 OK", function() {
    expect(res.status).to.equal(200);
  });
  test("returns an array", function() {
    expect(res.body).to.be.an("array");
  });
  test("Widget A is in results", function() {
    const found = res.body.some(p => p.name === "Widget A");
    expect(found).to.be.true;
  });
}
