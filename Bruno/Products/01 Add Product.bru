meta {
  name: Add Product
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/products
  body: json
  auth: none
}

body:json {
  {
    "name": "Widget A",
    "description": "A small red widget",
    "productImageUris": "",
    "validSkus": "SKU-001",
    "attributes": {
      "Color": "Red",
      "Brand": "Acme"
    },
    "categoryIds": [{{categoryId}}]
  }
}

assert {
  res.status: eq 201
  res.body.instanceId: isDefined
}

vars:post-response {
  productId: res.body.instanceId
}

tests {
  test("returns 201 Created", function() {
    expect(res.status).to.equal(201);
  });
  test("returns a numeric instanceId", function() {
    expect(res.body.instanceId).to.be.a("number");
    expect(res.body.instanceId).to.be.greaterThan(0);
  });
}
